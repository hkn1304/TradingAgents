# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=

# ── Market Data Providers ──────────────────────────────────────────────────────
# Tab 1 (Markets): live price, OHLCV, indicators, news
#   yfinance  — default, no API key required, supports all asset classes
#   polygon   — better intraday bars for metals/forex/crypto, requires POLYGON_API_KEY
#   oanda     — forex/metals real-time (not yet implemented)
#   binance   — crypto (not yet implemented)
MARKET_DATA_PROVIDER=yfinance

# Tab 2/3 (Agents / Analysis): data used inside the TradingAgents pipeline
#   Keep as yfinance unless you know what you are doing — the pipeline
#   dataflows are tightly coupled to yfinance internals.
PIPELINE_DATA_PROVIDER=yfinance

# Polygon API key (only needed if MARKET_DATA_PROVIDER=polygon)
POLYGON_API_KEY=

# Oanda credentials (only needed if MARKET_DATA_PROVIDER=oanda)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=

# Binance credentials (only needed if MARKET_DATA_PROVIDER=binance)
BINANCE_API_KEY=
BINANCE_API_SECRET=
